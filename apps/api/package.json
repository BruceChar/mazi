{
  "name": "@mazi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "dependencies": {
    "@fastify/cors": "^11",
    "@mazi/core": "workspace:*",
    "@mazi/libs": "workspace:*",
    "@mazi/runtime": "workspace:*",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-fastify": "^12",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/main.js",
    "dev": "tsc -b --watch & pid=$!; trap 'kill $pid 2>/dev/null' EXIT INT TERM; node --watch dist/main.js"
  },
  "devDependencies": {
    "@nestjs/testing": "^12",
    "fastify": "^5",
    "tsx": "^4.23.13"
  }
}
